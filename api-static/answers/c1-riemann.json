{"c1-riemann-n":{"type":"numeric","answer":0.125,"tolerance":1e-06,"solution":"(1/2)[0²+(1/2)²]=1/8.","hint":"Cada faixa mede 1/2."},"c1-riemann-c":{"type":"choice","answer":0,"options":["Sim","Não"],"solution":"x² é crescente em [0,1].","hint":"Distinga valor no ponto e comportamento local."},"riemann-direita2":{"type":"numeric","answer":0.625,"tolerance":1e-10,"solution":"(1/2)[(1/2)²+1²]=5/8.","hint":"Troque apenas os pontos marcados."},"riemann-esquerda4":{"type":"numeric","answer":0.21875,"tolerance":1e-10,"solution":"(0²+(1/4)²+(1/2)²+(3/4)²)/4=7/32.","hint":"As alturas esquerdas são 0,1/16,1/4,9/16."},"riemann-direita4":{"type":"numeric","answer":0.46875,"tolerance":1e-10,"solution":"L₄+1/4=7/32+8/32=15/32.","hint":"A largura entre cotas uniformes é 1/n."},"riemann-malha":{"type":"numeric","answer":0.5,"tolerance":1e-10,"solution":"As larguras são 1/4,1/4,1/2; a maior é 1/2.","hint":"Não use a largura média."},"riemann-largura":{"type":"numeric","answer":0.25,"tolerance":1e-10,"solution":"1/4.","hint":"Use a propriedade telescópica."},"riemann-meio":{"type":"numeric","answer":0.3125,"tolerance":1e-10,"solution":"(1/2)[1/16+9/16]=5/16.","hint":"É soma de alturas nos pontos médios, não média entre cotas."},"riemann-nao-inferior":{"type":"numeric","answer":0.140625,"tolerance":1e-10,"solution":"0×1/4+(1/4)²×1/4+(1/2)²×1/2=1/64+1/8=9/64.","hint":"Cada faixa tem sua própria largura."},"riemann-nao-superior":{"type":"numeric","answer":0.578125,"tolerance":1e-10,"solution":"(1/4)²×1/4+(1/2)²×1/4+1²×1/2=37/64.","hint":"Use as alturas direitas e as larguras corretas."},"riemann-integral":{"type":"numeric","answer":0.3333333333333333,"tolerance":1e-10,"solution":"As duas fórmulas de somas convergem para 1/3.","hint":"Separe o valor da integral da soma finita."},"riemann-faixa-larga":{"type":"numeric","answer":0.375,"tolerance":1e-10,"solution":"(1−1/4)×1/2=3/8.","hint":"A largura dessa faixa continua 1/2."}}