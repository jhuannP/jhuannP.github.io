from math import exp,expm1,isfinite,sqrt,log
from random import Random

def _count(n):
    if isinstance(n,bool) or not isinstance(n,int) or n<1:raise ValueError('Inteiro positivo necessário')
    return n

def _finite(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (TypeError,ValueError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def metropolis_gaussian(n,proposal=1,seed=42,x0=0):
    """Alvo proporcional a exp(-x²/2), passeio simétrico uniforme."""
    _count(n);proposal=_finite(proposal);x=_finite(x0)
    if proposal<=0:raise ValueError('Escala de proposta positiva necessária')
    rng=Random(seed);trace=[x];accepted=0
    for _ in range(n):
        candidate=x+rng.uniform(-proposal,proposal)
        if not isfinite(candidate):raise ArithmeticError('Proposta não finita')
        log_ratio=-candidate*candidate/2+x*x/2
        # Comparação em log evita overflow da razão de densidades.
        u=rng.random()
        if log_ratio>=0 or u==0 or log(u)<log_ratio:x=candidate;accepted+=1
        trace.append(x)
    return {'trace':trace,'accepted':accepted}

run=metropolis_gaussian(5000,2,42)
assert len(run['trace'])==5001 and 0<run['accepted']<5000
sample=run['trace'][1000:]
print('aceitação:',run['accepted']/5000,'média observada:',sum(sample)/len(sample))
