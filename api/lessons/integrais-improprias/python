from math import isfinite, sqrt, pi, cos, sin, exp, e, fsum

def _real(value):
    try:
        if isinstance(value,bool): raise ValueError
        result=float(value)
    except (TypeError,ValueError,OverflowError):
        raise ValueError('Valor real finito necessário') from None
    if not isfinite(result): raise ValueError('Valor real finito necessário')
    return result

def _quadrature(a,b,n):
    a,b=_real(a),_real(b)
    if not a<b or isinstance(n,bool) or not isinstance(n,int) or n<=0:raise ValueError('Intervalo crescente e número positivo de subintervalos necessários')
    return a,b,(b-a)/n

def _eval(f,x):
    return _real(f(x))

def trapezio(f,a,b,n):
    a,b,h=_quadrature(a,b,n)
    total=(_eval(f,a)+_eval(f,b))/2
    total+=sum(_eval(f,a+i*h) for i in range(1,n))
    return _real(h*total)

def simpson(f,a,b,n):
    a,b,h=_quadrature(a,b,n)
    if n%2:raise ValueError('Simpson composto exige número par de subintervalos')
    total=_eval(f,a)+_eval(f,b)
    total+=4*sum(_eval(f,a+i*h) for i in range(1,n,2))
    total+=2*sum(_eval(f,a+i*h) for i in range(2,n,2))
    return _real(h*total/3)

R=10
cortada=trapezio(lambda x:1/x**2,1,R,1000)
transformada=simpson(lambda t:1,0,1,2)
assert abs(cortada-.9)<1e-4 and transformada==1
print(cortada,'cauda exata:',1/R,'transformada:',transformada)
