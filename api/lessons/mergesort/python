def intercalar(a,b):
    saida = []; i = j = 0
    while i < len(a) and j < len(b):
        if a[i] <= b[j]:
            saida.append(a[i]); i += 1
        else:
            saida.append(b[j]); j += 1
    return saida + a[i:] + b[j:]
def mergesort(valores):
    if len(valores) <= 1:
        return list(valores)
    meio = len(valores)//2
    return intercalar(mergesort(valores[:meio]), mergesort(valores[meio:]))
assert intercalar([1,4],[2,3]) == [1,2,3,4]
assert mergesort([4,1,3,2,2]) == [1,2,2,3,4]
assert mergesort([]) == []
print(mergesort([4,1,3,2]))
