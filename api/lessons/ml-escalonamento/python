from math import exp,log1p,sqrt,hypot,atan2,cos,sin,isfinite
from random import Random

def finite(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (ValueError,TypeError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def scale_fit(x):
    x=[finite(v) for v in x]
    if not x:raise ValueError('Treino vazio')
    mean=sum(x)/len(x);std=sqrt(sum((v-mean)**2 for v in x)/len(x))
    return dict(mean=mean,scale=std if std>0 else 1.0)

def scale_transform(x,state):
    return [(finite(v)-state['mean'])/state['scale'] for v in x]

state=scale_fit([0,2])
assert state==dict(mean=1,scale=1)
assert scale_transform([4],state)==[3]
print(state)
