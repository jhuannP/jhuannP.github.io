from math import isclose

def energia(m, v):
    if m < 0:
        raise ValueError("Massa negativa")
    return 0.5*m*v*v

assert isclose(energia(2,3),9.0,rel_tol=1e-12)
assert energia(2,0) == 0.0
try:
    energia(-1,3)
except ValueError:
    print("Entrada inválida rejeitada")
else:
    raise AssertionError("Faltou validar a massa")