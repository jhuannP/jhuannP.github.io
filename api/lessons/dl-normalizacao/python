from math import exp,log,sqrt,hypot,sin,cos,isfinite
from random import Random

def real(x):
    if isinstance(x,bool):raise ValueError('Real finito necessário')
    try:y=float(x)
    except (TypeError,ValueError,OverflowError):raise ValueError('Real finito necessário') from None
    if not isfinite(y):raise ValueError('Real finito necessário')
    return y

def layer_norm(values,eps=1e-5):
    x=[real(v) for v in values];eps=real(eps)
    if not x or eps<=0:raise ValueError('Vetor e epsilon positivo necessários')
    mean=sum(x)/len(x);var=sum((v-mean)**2 for v in x)/len(x)
    return [(v-mean)/sqrt(var+eps) for v in x]

z=layer_norm([1,3])
assert abs(sum(z))<1e-12
assert layer_norm([2,2])==[0,0]
print(z)
