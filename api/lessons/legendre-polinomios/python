from math import isfinite,pi,sin,sqrt
from cmath import exp

def degree(n,maximum=50):
    if isinstance(n,bool) or not isinstance(n,int) or n<0 or n>maximum:
        raise ValueError('Grau inteiro fora da faixa didática')
    return n

def real(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (ValueError,TypeError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def legendre(n,x):
    degree(n);x=real(x)
    if abs(x)>1:raise ValueError('Exemplo restrito a [-1,1]')
    if n==0:return 1.0
    prev,current=1.,x
    for k in range(1,n):prev,current=current,((2*k+1)*x*current-k*prev)/(k+1)
    return current

assert legendre(2,0)==-.5
for n in range(8):assert abs(legendre(n,1)-1)<1e-12
print([legendre(n,.3) for n in range(5)])
