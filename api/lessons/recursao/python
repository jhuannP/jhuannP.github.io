def natural(n):
    if not isinstance(n,int) or isinstance(n,bool) or n<0:
        raise ValueError("Use inteiro não negativo")

def fatorial(n):
    natural(n)
    if n==0:return 1
    return n*fatorial(n-1)

def fatorial_iterativo(n):
    natural(n)
    value=1
    for j in range(1,n+1):value*=j
    return value

def potencia(base,n):
    natural(n)
    if not isinstance(base,int) or isinstance(base,bool):raise ValueError("Base inteira")
    if n==0:return 1
    q=potencia(base,n//2)
    value=q*q
    return value*base if n%2 else value

assert fatorial(0)==1 and fatorial(5)==120
assert fatorial(12)==fatorial_iterativo(12)
assert potencia(3,5)==243
print(fatorial(4),potencia(2,4))
