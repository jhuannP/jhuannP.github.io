"""Forma escalonada reduzida e soluções: matrizes pequenas de int/Fraction."""
from fractions import Fraction as Q

def rational(x):
    if isinstance(x,bool) or not isinstance(x,(int,Q)):raise ValueError('Use int ou Fraction, sem floats')
    return Q(x)

def rref(matrix):
    if not 1<=len(matrix)<=20:raise ValueError('De 1 a 20 linhas')
    width=len(matrix[0])
    if not 1<=width<=21 or any(len(row)!=width for row in matrix):raise ValueError('Matriz retangular, de 1 a 21 colunas')
    out=[[rational(x) for x in row] for row in matrix]
    pivots=[];row=0
    for column in range(width):
        pivot=next((i for i in range(row,len(out)) if out[i][column]!=0),None)
        if pivot is None:continue
        out[row],out[pivot]=out[pivot],out[row]
        scale=out[row][column];out[row]=[x/scale for x in out[row]]
        for i in range(len(out)):
            if i!=row:
                multiple=out[i][column]
                out[i]=[a-multiple*b for a,b in zip(out[i],out[row])]
        pivots.append(column);row+=1
        if row==len(out):break
    return out,pivots

def solve(A,b):
    if not A or not A[0] or len(A[0])>20 or len(b)!=len(A):raise ValueError('Dimensões de A e b incompatíveis')
    n=len(A[0]);reduced,pivots=rref([list(row)+[rhs] for row,rhs in zip(A,b)])
    coeff=[p for p in pivots if p<n]
    free=[j for j in range(n) if j not in coeff]
    inconsistent=any(all(x==0 for x in row[:n]) and row[n]!=0 for row in reduced)
    basis=[]
    for f in free:
        vector=[Q(0)]*n;vector[f]=Q(1)
        for i,p in enumerate(coeff):vector[p]=-reduced[i][f]
        basis.append(vector)
    particular=None
    if not inconsistent:
        particular=[Q(0)]*n
        for i,p in enumerate(coeff):particular[p]=reduced[i][n]
    return dict(status='inconsistente' if inconsistent else 'unica' if not free else 'infinitas',
                reduced=reduced,pivots=coeff,free=free,rank_A=len(coeff),rank_augmented=len(pivots),
                particular=particular,null_basis=basis)

if __name__=='__main__':
    for A,b in [([[1,1],[1,-1]],[3,1]),([[1,2],[2,4]],[3,6]),([[1,2],[2,4]],[3,7])]:
        result=solve(A,b);print('Sistema:',A,b,'status:',result['status'])
        print('Reduzida:',result['reduced'],'particular:',result['particular'],'base do núcleo:',result['null_basis'])

# Demonstração de representação exata versus arredondamento.
eps=Q(1,10**20)
A=[[1,1],[1,1+eps]]
assert solve(A,[2,2+eps])['rank_A']==2
assert 1.0+float(eps)==1.0
print('Posto racional: 2; float perde o incremento neste exemplo.')
