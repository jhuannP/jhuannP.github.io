from math import exp,expm1,isfinite,sqrt,log
from random import Random

def _finite(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (TypeError,ValueError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def markov_step(distribution,P):
    p=[_finite(v) for v in distribution];n=len(p)
    if not n or len(P)!=n or any(len(row)!=n for row in P):raise ValueError('Dimensão incompatível')
    rows=[[_finite(v) for v in row] for row in P]
    if min(p)<0 or abs(sum(p)-1)>1e-12:raise ValueError('Distribuição inválida')
    if any(min(row)<0 or abs(sum(row)-1)>1e-12 for row in rows):raise ValueError('Matriz não estocástica')
    return [sum(p[i]*rows[i][j] for i in range(n)) for j in range(n)]

pi=[1/3,2/3];P=[[.8,.2],[.1,.9]]
assert max(abs(a-b) for a,b in zip(markov_step(pi,P),pi))<1e-12
assert abs(pi[0]*.2-pi[1]*.1)<1e-12
print(pi)
