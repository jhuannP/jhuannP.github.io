from math import exp,log,expm1,isfinite
from itertools import product

def finite(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (TypeError,ValueError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def entropy(probabilities):
    p=[finite(v) for v in probabilities]
    if not p or min(p)<0 or abs(sum(p)-1)>1e-12:raise ValueError('Distribuição normalizada necessária')
    return -sum(v*log(v) for v in p if v>0)

assert abs(entropy([.5,.5])-log(2))<1e-12
assert entropy([1,0])==0
print(entropy([.5,.5]))
