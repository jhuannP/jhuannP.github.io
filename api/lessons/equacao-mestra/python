from math import exp,log,expm1,isfinite
from itertools import product

def finite(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (TypeError,ValueError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def master_two(p0,rate01,rate10,t):
    p0=finite(p0);a=finite(rate01);b=finite(rate10);t=finite(t)
    if not 0<=p0<=1 or a<0 or b<0 or t<0:raise ValueError('Parâmetros de taxas inválidos')
    if a+b==0:return p0
    eq=b/(a+b)
    return eq+(p0-eq)*exp(-(a+b)*t)

assert abs(master_two(1,1,3,10)-.75)<1e-12
assert master_two(.2,0,0,10)==.2
print(master_two(1,1,3,1))
