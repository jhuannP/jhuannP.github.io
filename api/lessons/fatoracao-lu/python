from math import isfinite, sqrt, pi, cos, sin, exp, e, fsum

def _real(value):
    try:
        if isinstance(value,bool): raise ValueError
        result=float(value)
    except (TypeError,ValueError,OverflowError):
        raise ValueError('Valor real finito necessário') from None
    if not isfinite(result): raise ValueError('Valor real finito necessário')
    return result

def _system(A,b):
    n=len(A)
    if n==0 or len(b)!=n or any(len(row)!=n for row in A):raise ValueError('Sistema quadrado não vazio necessário')
    return [[_real(x) for x in row] for row in A],[_real(x) for x in b]

def lu_sem_pivo(A):
    A,_=_system(A,[0]*len(A));n=len(A)
    L=[[0.0]*n for _ in range(n)];U=[[0.0]*n for _ in range(n)]
    for i in range(n):
        L[i][i]=1.0
        for j in range(i,n):U[i][j]=_real(A[i][j]-sum(L[i][k]*U[k][j] for k in range(i)))
        if U[i][i]==0:raise ArithmeticError('Pivô zero; esta implementação de LU não troca linhas')
        for j in range(i+1,n):L[j][i]=_real((A[j][i]-sum(L[j][k]*U[k][i] for k in range(i)))/U[i][i])
    return L,U

A=[[4,3],[6,3]]
L,U=lu_sem_pivo(A)
reconstruida=[[sum(L[i][k]*U[k][j] for k in range(2)) for j in range(2)] for i in range(2)]
assert reconstruida==A
