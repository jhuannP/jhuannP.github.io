from math import exp,expm1,isfinite,sqrt,log
from random import Random

def _finite(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (TypeError,ValueError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def ou_moments(theta,sigma,x0,t):
    theta=_finite(theta);sigma=_finite(sigma);x0=_finite(x0);t=_finite(t)
    if theta<=0 or sigma<0 or t<0:raise ValueError('theta>0, sigma>=0 e t>=0 necessários')
    a=exp(-theta*t)
    return _finite(a*x0),_finite(sigma*sigma*(-expm1(-2*theta*t))/(2*theta))

def ou_transition(x,theta,sigma,dt,z):
    mean,var=ou_moments(theta,sigma,x,dt)
    if dt<=0:raise ValueError('Passo positivo necessário')
    return _finite(mean+sqrt(var)*_finite(z))

rng=Random(42);x=1
for _ in range(100):x=ou_transition(x,2,2,.01,rng.gauss(0,1))
mean,var=ou_moments(2,2,1,1)
assert abs(var-(1-exp(-4)))<1e-12
