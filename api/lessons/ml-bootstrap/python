from math import exp,log1p,sqrt,hypot,atan2,cos,sin,isfinite
from random import Random

def finite(x):
    if isinstance(x,bool):raise ValueError('Número real finito necessário')
    try:y=float(x)
    except (ValueError,TypeError,OverflowError):raise ValueError('Número real finito necessário') from None
    if not isfinite(y):raise ValueError('Número real finito necessário')
    return y

def bootstrap_means(values,reps=1000,seed=42):
    x=[finite(v) for v in values]
    if not x or isinstance(reps,bool) or not isinstance(reps,int) or reps<1:raise ValueError('Amostra e repetições necessárias')
    rng=Random(seed)
    return [sum(rng.choice(x) for _ in x)/len(x) for _ in range(reps)]

values=bootstrap_means([1,3],1000,42)
assert set(values)<={1,2,3}
print(sum(values)/len(values),min(values),max(values))
