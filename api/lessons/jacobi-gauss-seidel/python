from math import isfinite, sqrt, pi, cos, sin, exp, e, fsum

def _real(value):
    try:
        if isinstance(value,bool): raise ValueError
        result=float(value)
    except (TypeError,ValueError,OverflowError):
        raise ValueError('Valor real finito necessário') from None
    if not isfinite(result): raise ValueError('Valor real finito necessário')
    return result

def _params(tol,max_iter):
    tol=_real(tol)
    if tol<=0 or isinstance(max_iter,bool) or not isinstance(max_iter,int) or max_iter<=0:
        raise ValueError('Tolerância positiva e orçamento inteiro positivo necessários')
    return tol

def _system(A,b):
    n=len(A)
    if n==0 or len(b)!=n or any(len(row)!=n for row in A):raise ValueError('Sistema quadrado não vazio necessário')
    return [[_real(x) for x in row] for row in A],[_real(x) for x in b]

def norma_inf(v):
    return max((abs(_real(x)) for x in v),default=0.0)

def residuo(A,x,b):
    A,b=_system(A,b)
    if len(x)!=len(b):raise ValueError('Vetor de solução incompatível')
    x=[_real(v) for v in x]
    return [_real(bi-sum(aij*xj for aij,xj in zip(row,x))) for row,bi in zip(A,b)]

def iterar_sistema(A,b,metodo='jacobi',tol=1e-10,max_iter=500):
    tol=_params(tol,max_iter);A,b=_system(A,b);n=len(b)
    if metodo not in ('jacobi','gauss-seidel'):raise ValueError('Método desconhecido')
    if any(A[i][i]==0 for i in range(n)):raise ArithmeticError('Diagonal zero')
    x=[0.0]*n
    for _ in range(max_iter):
        novo=[0.0]*n
        for i in range(n):
            anterior=novo if metodo=='gauss-seidel' else x
            soma=sum(A[i][j]*(anterior[j] if j<i else x[j]) for j in range(n) if j!=i)
            novo[i]=_real((b[i]-soma)/A[i][i])
        passo=norma_inf([a-c for a,c in zip(novo,x)])
        if passo<=tol*(1+norma_inf(novo)) and norma_inf(residuo(A,novo,b))<=tol*(1+norma_inf(b)):return novo
        x=novo
    raise RuntimeError('Orçamento atingido sem cumprir passo e resíduo')

A=[[4,1],[1,3]];b=[1,2]
for metodo in ['jacobi','gauss-seidel']:
    x=iterar_sistema(A,b,metodo)
    assert max(abs(x[0]-1/11),abs(x[1]-7/11))<1e-9
    print(metodo,x)
