from fractions import Fraction as Q

def rates(c):
    c=Q(c)
    if c<0:raise ValueError("Concentração não negativa")
    plus=3*c-3;minus=c-5
    return plus,minus,plus+minus

assert rates(2)==(3,-3,0)
assert rates(Q(3,2))==(Q(3,2),Q(-7,2),-2)
assert rates(3)==(6,-2,4)
for c in (0,1,2,3,5,6):print(c,rates(c))
